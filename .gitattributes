# Windows batch files MUST be CRLF and pure ASCII.
# cmd.exe misparses LF-only .bat files (block/if structure breaks), and
# UTF-8 Chinese inside a .bat is mojibake'd under the GBK console codepage,
# which makes every mangled line get executed as a command.
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Shell scripts must stay LF or bash refuses to run them.
*.sh  text eol=lf

# Data artifacts: never let git rewrite line endings.
*.csv -text
*.db  binary

# Source code: keep LF in both repo and working tree.
# Prevents autocrlf-induced spurious "modified" noise when editors write LF
# (e.g. the agent's tooling writes LF; checkout would otherwise produce CRLF).
*.py   text eol=lf
*.js   text eol=lf
*.jsx  text eol=lf
*.ts   text eol=lf
*.tsx  text eol=lf
*.css  text eol=lf
*.json text eol=lf
*.html text eol=lf
